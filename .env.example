# Configurações de Rastreamento (Google Analytics e Google Ads)
# Substitua com seus próprios IDs no ambiente de produção.
# Exemplo de ID do Analytics: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Exemplo de ID do Google Ads: AW-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=

# Rótulo de Conversão do Google Ads (para cliques no WhatsApp)
# Exemplo: AW-XXXXXXXXXX/AbCdEfGhIjK
VITE_GOOGLE_ADS_CONVERSION_ID=
